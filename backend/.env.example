# Backend configuration — copy to .env for local runs.
API_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_tracker
DB_USER=tracker_user
DB_PASSWORD=tracker_pass

REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-secret-change-me
INGEST_API_KEY=dev-tracker-key

# Domain tuning
SPRINT_SPEED_KMH=20
FIELD_LENGTH_M=105
FIELD_WIDTH_M=68
HEATMAP_CELL_M=10
SAMPLE_RATE_HZ=10
